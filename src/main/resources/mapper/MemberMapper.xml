<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.MemberMapper">

    <resultMap id="memberMap" type="com.example.demo.entity.Member">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="nickname" property="nickname"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="total_points" property="totalPoints"/>
        <result column="available_points" property="availablePoints"/>
        <result column="level_id" property="levelId"/>
        <result column="register_time" property="registerTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="findAll" resultMap="memberMap">
        SELECT * FROM member ORDER BY id ASC
    </select>

    <select id="findById" resultMap="memberMap">
        SELECT * FROM member WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="memberMap">
        SELECT * FROM member WHERE username = #{username}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO member (username, nickname, phone, email, total_points, available_points,
                            level_id, register_time, update_time)
        VALUES (#{username}, #{nickname}, #{phone}, #{email}, #{totalPoints}, #{availablePoints},
                #{levelId}, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE member
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="totalPoints != null">total_points = #{totalPoints},</if>
            <if test="availablePoints != null">available_points = #{availablePoints},</if>
            <if test="levelId != null">level_id = #{levelId},</if>
            update_time = NOW(),
        </set>
        WHERE id = #{id}
    </update>

    <update id="updatePoints">
        UPDATE member
        SET total_points = #{totalPoints},
            available_points = #{availablePoints},
            level_id = #{levelId},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM member WHERE id = #{id}
    </delete>

</mapper>
