<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.PointsRecordMapper">

    <resultMap id="pointsRecordMap" type="com.example.demo.entity.PointsRecord">
        <id column="id" property="id"/>
        <result column="member_id" property="memberId"/>
        <result column="points" property="points"/>
        <result column="type" property="type"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="findByMemberId" resultMap="pointsRecordMap">
        SELECT * FROM points_record WHERE member_id = #{memberId} ORDER BY create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO points_record (member_id, points, type, description, create_time)
        VALUES (#{memberId}, #{points}, #{type}, #{description}, NOW())
    </insert>

</mapper>
